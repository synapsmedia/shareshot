<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <style>:root { --accent: {{cssColor accent "#7C3AED"}}; }</style>
  {{{styleTag}}}
</head>
<body>
  {{#if badge}}<span class="watermark" aria-hidden="true">{{badge}}</span>{{/if}}
  <main>
    <header>
      {{#if badge}}<span class="badge">{{badge}}</span>{{/if}}
      {{#if date}}<span class="date">{{date}}</span>{{/if}}
    </header>
    <div class="content">
      <h1 class="clamp">{{title}}</h1>
      {{#if description}}<p class="description clamp">{{description}}</p>{{/if}}
    </div>
    <footer class="site">{{#if logo}}<img class="logo" src="{{logo}}" alt="">{{/if}}{{#if siteName}}<span class="site-name">{{siteName}}</span>{{/if}}</footer>
  </main>
</body>
</html>
