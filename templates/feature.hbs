<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <style>:root { --accent: {{cssColor accent "#E8572A"}}; }</style>
  {{{styleTag}}}
</head>
<body>
  {{#if image}}<img class="photo" src="{{image}}" alt="">{{/if}}
  <main>
    <header class="site">{{#if logo}}<img class="logo" src="{{logo}}" alt="">{{/if}}{{#if siteName}}<span class="site-name">{{siteName}}</span>{{/if}}</header>
    <div class="content">
      {{#if tag}}<p class="tag">{{tag}}</p>{{/if}}
      <h1 class="clamp">{{title}}</h1>
      <footer>
      {{#if author}}
      <div class="byline">
        <span class="avatar">{{#if authorImage}}<img src="{{authorImage}}" alt="">{{else}}{{author.[0]}}{{/if}}</span>
        <span class="author">{{author}}</span>
        {{#if date}}<span class="date">{{date}}</span>{{/if}}
      </div>
      {{else if date}}
      <span class="date">{{date}}</span>
      {{/if}}
      </footer>
    </div>
  </main>
</body>
</html>
